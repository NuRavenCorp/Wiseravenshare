VITE_API_URL=/api

# Set to true only when backend auth is unavailable during local development.
VITE_AUTH_BYPASS=false

# Optional: auto-login a local dev user when bypass is enabled.
VITE_AUTH_AUTO_LOGIN=false

# Stripe Configuration (Music Rights Studio Plans)
# Get these values from your Stripe Dashboard after creating products
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_... # or pk_live_...
VITE_STRIPE_MUSIC_STUDIO_RIGHTS_BASIC_PROD_ID=prod_... # Basic Protection ($4.99/mo)
VITE_STRIPE_MUSIC_STUDIO_RIGHTS_STANDARD_PROD_ID=prod_... # Standard Protection ($14.99/mo)
VITE_STRIPE_MUSIC_STUDIO_RIGHTS_PRO_PROD_ID=prod_... # Pro Protection ($29.99/mo)
