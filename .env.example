VITE_API_URL=/api

# Set to true only when backend auth is unavailable during local development.
VITE_AUTH_BYPASS=false

# Optional: auto-login a local dev user when bypass is enabled.
VITE_AUTH_AUTO_LOGIN=false

# Stripe Configuration (Music Rights Studio Plans)
# Get these values from your Stripe Dashboard after creating prices
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_... # or pk_live_...
VITE_STRIPE_MUSIC_STUDIO_RIGHTS_BASIC_MONTHLY_PRICE_ID=price_... # Basic Protection ($4.99/mo)
VITE_STRIPE_MUSIC_STUDIO_RIGHTS_BASIC_ANNUAL_PRICE_ID=price_... # Basic Protection ($49.99/yr)
VITE_STRIPE_MUSIC_STUDIO_RIGHTS_STANDARD_MONTHLY_PRICE_ID=price_... # Standard Protection ($14.99/mo)
VITE_STRIPE_MUSIC_STUDIO_RIGHTS_STANDARD_ANNUAL_PRICE_ID=price_... # Standard Protection ($149.99/yr)
VITE_STRIPE_MUSIC_STUDIO_RIGHTS_PRO_MONTHLY_PRICE_ID=price_... # Pro Protection ($29.99/mo)
VITE_STRIPE_MUSIC_STUDIO_RIGHTS_PRO_ANNUAL_PRICE_ID=price_... # Pro Protection ($299.99/yr)
