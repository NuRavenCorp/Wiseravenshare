{
  "name": "wiseravenshare.client",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:assets": "npx @capacitor/assets generate --android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "android:release:win": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-release.ps1"
  },
  "dependencies": {
    "@microsoft/signalr": "^9.0.8",
    "axios": "^1.18.1",
    "firebase": "^12.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.12"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "postcss": "^8.5.23"
  }
}
