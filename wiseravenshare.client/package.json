{
  "name": "wiseravenshare.client",
  "private": true,
  "version": "1.0.7",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --logLevel error",
    "preview": "vite preview",
    "android:assets": "npx @capacitor/assets generate --android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "android:release:win": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-release.ps1"
  },
  "dependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@microsoft/signalr": "^10.0.11",
    "@twilio/conversations": "^3.0.1",
    "axios": "^1.18.1",
    "framer-motion": "^13.2.0",
    "howler": "^2.2.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "playwright": "^1.62.1",
    "vite": "^8.0.12"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "postcss": "^8.5.23"
  }
}
