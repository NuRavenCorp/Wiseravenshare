FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Minimal deps — no ML libraries needed for lyric scoring
RUN pip install --no-cache-dir fastapi==0.115.5 uvicorn[standard]==0.32.0 pydantic==2.10.6

COPY lyric_scoring_service.py .

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=5s --start_period=15s --retries=3 \
    CMD curl -f http://localhost:8100/health || exit 1

CMD ["uvicorn", "lyric_scoring_service:app", "--host", "0.0.0.0", "--port", "8100", "--workers", "2"]
