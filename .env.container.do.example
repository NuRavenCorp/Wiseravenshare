# DigitalOcean-focused container environment
# Copy to .env.container and replace placeholders.

# App runtime
ASPNETCORE_ENVIRONMENT=Production
CLIENT_ORIGIN=http://localhost:8088

# Use managed DO PostgreSQL (recommended for hybrid mode)
# In DigitalOcean: Databases -> wiseravenshare-db -> Connection Details
# Pick trusted source or add your local public IP in Trusted Sources.
EXTERNAL_POSTGRES_CONNECTION=Host=REPLACE_DB_HOST;Port=25060;Database=defaultdb;Username=doadmin;Password=REPLACE_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# Optional managed Redis/Valkey
# If you create managed Redis in DO, set full endpoint here.
# Example: rediss://default:REPLACE_PASSWORD@REPLACE_HOST:25061
REDIS_CONNECTION_STRING=redis:6379

# Stripe from Stripe Dashboard
STRIPE_PUBLISHABLE_API=pk_live_REPLACE
STRIPE_RESTRICTED_API=rk_live_REPLACE
STRIPE_SECRET_API=sk_live_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# Communique Twilio (SMS/WhatsApp/Verify)
COMMUNIQUE_TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=AC_REPLACE
TWILIO_AUTH_TOKEN=REPLACE_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=+1REPLACE
COMMUNIQUE_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VERIFY_SERVICE_SID=VA_REPLACE

# DO Spaces (S3-compatible object storage)
# In DigitalOcean: Spaces -> your space -> Settings/API keys
BLOB_BUCKET_NAME=bucket-wrs-01010
BLOB_PROJECT_FOLDER=wiseravenshare
BLOB_SITE_NAME=wiseravenshare
S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
S3_ACCESS_KEY=REPLACE_SPACES_KEY
S3_SECRET_KEY=REPLACE_SPACES_SECRET
S3_REGION=sfo3
S3_FORCE_PATH_STYLE=false

# Social Media & Aggregator Feeds Configuration
Social__Facebook__PageId=REPLACE_FACEBOOK_PAGE_ID
Social__Facebook__PageAccessToken=REPLACE_FACEBOOK_PAGE_ACCESS_TOKEN
Social__TikTok__Username=REPLACE_TIKTOK_USERNAME
Social__TikTok__AccessToken=REPLACE_TIKTOK_ACCESS_TOKEN
Authentication__OAuthProviders__TikTok__ClientId=awlr7zbl6p35t0ph
Authentication__OAuthProviders__TikTok__ClientSecret=3UIMMcLZ0FbCV5gZeU56k9qfjtTWxRWI
Social__Bluesky__Handle=bsky.app
Social__Bluesky__AppPassword=REPLACE_BLUESKY_APP_PASSWORD
Social__Reddit__Subreddit=technology
Social__YouTube__ChannelId=REPLACE_YOUTUBE_CHANNEL_ID
