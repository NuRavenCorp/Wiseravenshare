{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "AllowSelfRegistration": true,
    "Users": [
      {
        "Name": "Wiseraven Admin",
        "Email": "admin@wise-ravens.com",
        "Password": "CHANGE_ME"
      }
    ],
    "Jwt": {
      "Issuer": "Wiseravenshare.Server",
      "Audience": "Wiseravenshare.Client",
      "Key": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_IN_ENV",
      "ExpiresMinutes": 60
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=REPLACE_WITH_DB_HOST;Port=5432;Database=REPLACE_WITH_DB_NAME;Username=REPLACE_WITH_DB_USER;Password=REPLACE_WITH_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Persistence": {
    "RequireDatabase": true,
    "DiagnosticsTimeoutSeconds": 4
  },
  "Database": {
    "ExpectedName": "defaultdb"
  },
  "Storage": {
    "Blob": {
      "BucketName": "bucket-wrs-01010",
      "ProjectFolder": "wiseravenshare",
      "SiteName": "wiseravenshare"
    },
    "Video": {
      "StorageFolderName": "ravensight_videos",
      "DefaultFolder": "wiseravenshare/ravensight/video"
    }
  },
  "Stripe": {
    "PublishableKey": "",
    "SecretKey": "",
    "WebhookSecret": "",
    "PriceMonthlyId": "",
    "PriceAnnualId": ""
  },
  "Social": {
    "Facebook": {
      "PageId": "",
      "PageAccessToken": ""
    },
    "TikTok": {
      "Username": "",
      "AccessToken": ""
    },
    "Instagram": {
      "Username": "",
      "ProfileUrl": ""
    }
  },
  "NewsApis": {
    "NewsDataIo": {
      "ApiKey": ""
    },
    "Mediastack": {
      "ApiKey": ""
    },
    "SerpApi": {
      "ApiKey": ""
    }
  },
  "ReminderNotifications": {
    "Email": {
      "FromName": "Wise Ravens Planner",
      "FromAddress": "",
      "SmtpHost": "",
      "SmtpPort": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": ""
    },
    "Sms": {
      "TwilioAccountSid": "",
      "TwilioAuthToken": "",
      "TwilioFromNumber": ""
    }
  },
  "SyntheticEngagement": {
    "Enabled": false,
    "DefaultPrefix": "syntheticbot",
    "DefaultEmailDomain": "synthetic.wise-ravens.local"
  }
}