# Copy this file to .env.container and fill in real values.

# App runtime
ASPNETCORE_ENVIRONMENT=Production
CLIENT_ORIGIN=http://localhost:8088

# Option A: Use local postgres container (enable profile local-db)
POSTGRES_DB=wiseravenshare-db
POSTGRES_USER=wiseravenshare_user
POSTGRES_PASSWORD=CHANGE_ME

# Option B: Use DigitalOcean managed PostgreSQL (disable local-db profile)
# Example:
# EXTERNAL_POSTGRES_CONNECTION=Host=db-postgresql-nyc3-12345-do-user-123456-0.l.db.ondigitalocean.com;Port=25060;Database=defaultdb;Username=doadmin;Password=REPLACE_ME;SSL Mode=Require;Trust Server Certificate=true
EXTERNAL_POSTGRES_CONNECTION=

# Redis
# Leave blank to use local redis profile; override for managed redis URL.
REDIS_CONNECTION_STRING=redis:6379

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Blob storage (local MinIO or DO Spaces compatible values)
BLOB_BUCKET_NAME=wiseravenshare-dev
BLOB_PROJECT_FOLDER=wiseravenshare
BLOB_SITE_NAME=wiseravenshare
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
