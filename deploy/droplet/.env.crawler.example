# Copy to .env.crawler and fill values before first deployment.

# Core auth and admin access
ADMIN_EMAIL=admin@wise-ravens.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
Admin__Emails__0=admin@wise-ravens.com
Authentication__Users__0__Name=Wiseraven Admin
Authentication__Users__0__Email=admin@wise-ravens.com
Authentication__Users__0__Password=REPLACE_WITH_STRONG_PASSWORD
Authentication__Jwt__Issuer=Wiseravenshare.Server
Authentication__Jwt__Audience=Wiseravenshare.Client
Authentication__Jwt__Key=REPLACE_WITH_LONG_RANDOM_JWT_KEY
Authentication__Jwt__ExpiresMinutes=1440

# App origin and CORS
CLIENT_ORIGIN=https://wiseravenshare.com
VITE_API_URL=https://wiseravenshare.com/api
VITE_RAVENSIGHT_API_URL=https://wiseravenshare.com/api/ravensight
VITE_ADMIN_EMAILS=admin@wise-ravens.com

# Database and persistence
DATABASE_URL=postgres://USER:PASSWORD@HOST:25060/defaultdb?sslmode=require
ConnectionStrings__DefaultConnection=Host=HOST;Port=25060;Database=defaultdb;Username=USER;Password=PASSWORD;SSL Mode=Require;Trust Server Certificate=true
DATABASE_EXPECTED_NAME=defaultdb
PERSISTENCE_REQUIRE_DATABASE=true

# Optional crawler tuning
CRAWL_API_PORT=18080
CRAWL_INTERVAL_SECONDS=1800
CRAWL_START_URL=https://wiseravenshare.com
CRAWL_SCOPE=FullSite
CRAWL_MAX_PAGES=5000
CRAWL_MAX_DEPTH=10
CRAWL_REQUESTS_PER_SECOND=5
CRAWL_RENDER_JAVASCRIPT=true
CRAWL_RESPECT_ROBOTS_TXT=true
CRAWL_FOLLOW_EXTERNAL_LINKS=false
CRAWL_CAPTURE_SCREENSHOTS=false
CRAWL_SKIP_IF_RUNNING=true
CRAWL_JOB_NAME_PREFIX=Scheduled Full Site Crawl

# Optional Storage/AI secrets (if crawler analysis paths require them)
Storage__Blob__BucketName=bucket-wrs-01010
Storage__Blob__ProjectFolder=wiseravenshare/
Storage__Blob__Endpoint=nyc3.digitaloceanspaces.com
Storage__Blob__Region=nyc3
Storage__Blob__AccessKey=REPLACE_WITH_SPACES_ACCESS_KEY
Storage__Blob__SecretKey=REPLACE_WITH_SPACES_SECRET_KEY
Storage__Blob__PublicBaseUrl=https://bucket-wrs-01010.nyc3.digitaloceanspaces.com
Storage__Blob__CdnPublicBaseUrl=https://cdn.wise-ravens.com

AiProvider=gradient
Gradient__BaseUrl=https://ingress.do-ai.run/v1
Gradient__DefaultModel=gpt-4o-mini
Gradient__InferenceKey=REPLACE_WITH_GRADIENT_KEY
