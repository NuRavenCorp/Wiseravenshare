{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Features": {
    "AiAssistantGated": true,
    "Paywalls": {
      "Bypass": true
    }
  },
  "Admins": [
    {
      "Name": "admin",
      "Email": "admin@wiseravenshare.com",
      "Password": ""
    },
    {
      "Name": "admin0",
      "Email": "admin@wiseravenshare.com",
      "Password": ""
    },
    {
      "Name": "admin1",
      "Email": "arnoldspence@wiseravenshare.com",
      "Password": ""
    },
    {
      "Name": "admin2",
      "Email": "gaius@wiseravenshare.com",
      "Password": ""
    }
  ],
  "Jwt": {
    "Issuer": "Wiseravenshare.Server",
    "Audience": "Wiseravenshare.Client",
    "Key": "",
    "ExpiresMinutes": 60
  },
  "Admin": {
    "Emails": [
      "admin@wise-ravens.com"
    ]
  },
  "InternalApi": {
    "ContentCrawlerIngestKey": ""
  },
  "AllowedHosts": "*",
  "MlService": {
    "BaseUrl": "http://localhost:8005"
  },
  "AudioService": {
    "BaseUrl": "http://localhost:8001"
  },
  "KaraokeService": {
    "BaseUrl": "http://localhost:8002"
  },
  "KaraokeSpeechService": {
    "BaseUrl": "http://localhost:8003"
  },
  "PythonMatrixService": {
    "BaseUrl": "http://localhost:8005"
  },
  "PythonServices": {
    "Enabled": true,
    "PipInstallOnStartup": true,
    "MaxRestarts": 5,
    "ShutdownGracePeriodSeconds": 10,
    "Services": [
      { "Name": "audio-processor", "Port": 8001, "Enabled": true, "RelativePath": "services/audio-processor", "Module": "main:app" },
      { "Name": "karaoke-engine",  "Port": 8002, "Enabled": true },
      { "Name": "karaoke-speech",  "Port": 8003, "Enabled": true },
      { "Name": "python-matrix", "Port": 8005, "Enabled": true, "RelativePath": "wiseravenshare.Server/python-matrix", "Module": "main:app" }
    ]
  },
  "MeteredTurn": {
    "AppName": "",
    "CredentialApiKey": "",
    "Region": "global",
    "TimeoutSeconds": 4
  },
  "FeedRanking": {
    "Thresholds": {
      "NegativeVetoThreshold": 0.30,
      "AttentionCompletionThreshold": 0.50,
      "AttentionDwellSecondsThreshold": 30,
      "MeaningfulThreshold": 0.40,
      "LongTermValueThreshold": 0.35,
      "FatigueScoreThreshold": 0.55,
      "CompletionDropThreshold": 0.15,
      "BaseResurfacingThreshold": 0.45,
      "FatiguedResurfacingThreshold": 0.70
    }
  }
}
