# Copy to ".env" in the same folder before running docker compose.

POSTGRES_DB=wiseravenshare_db
POSTGRES_USER=wiseravenshare_user
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

API_PORT=10000
APP_PUBLIC_BASE_URL=http://localhost:10000
CLIENT_ORIGIN=http://localhost:10000,http://localhost:3000
Authentication__Jwt__Key=replace-with-a-long-random-secret

PYTHON_MATRIX_PORT=8005
PYTHON_MATRIX_BASE_URL=http://python-matrix:8005

PERSISTENCE_REQUIRE_DATABASE=true
PYTHON_SERVICES_ENABLED=false

REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-this-minio-secret
BLOB_BUCKET_NAME=wiseravenshare-dev
BLOB_PROJECT_FOLDER=wiseravenshare
BLOB_SITE_NAME=wiseravenshare

AI_PROVIDER=gradient
GRADIENT_BASE_URL=https://ingress.do-ai.run/v1
GRADIENT_DEFAULT_MODEL=gpt-4o-mini
GRADIENT_INFERENCE_KEY=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_KARAOKE_PRO_MONTHLY_ID=
STRIPE_PRICE_KARAOKE_PRO_ANNUAL_ID=
STRIPE_PRICE_PODCAST_PRO_MONTHLY_ID=
STRIPE_PRICE_PODCAST_PRO_ANNUAL_ID=

# Metered TURN (optional). If METERED_TURN_CREDENTIALS_ENDPOINT is set,
# the server calls that endpoint with ?apiKey=... and optional region.
METERED_TURN_APP_NAME=
METERED_TURN_CREDENTIALS_ENDPOINT=
METERED_TURN_API_KEY=
METERED_TURN_REGION=

# Agora live video (optional)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRY_SECONDS=3600

# News API keys (optional — enable images and broader sources in AI News Desk)
# NewsData.io: https://newsdata.io → free tier 200 req/day
NewsApis__NewsDataIo__ApiKey=
# Mediastack: https://mediastack.com → free tier available
NewsApis__Mediastack__ApiKey=
# SerpApi: https://serpapi.com → Google News thumbnails, 100 free/month
NewsApis__SerpApi__ApiKey=
# GNews: https://gnews.io → free 100 req/day, returns article images
NewsApis__GNews__ApiKey=
# The Guardian Open Platform: https://open-platform.theguardian.com → 500 free req/day
# Default "test" key works at low rate; register for a free key for higher limits
NewsApis__Guardian__ApiKey=test
# TheNewsAPI: https://www.thenewsapi.com → free 100 req/day, returns images
NewsApis__TheNewsApi__ApiKey=
